{
  "font-family": {
    "heading": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_FAMILY"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "text",
      "$value": "Quicksand"
    },
    "text": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_FAMILY"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "text",
      "$value": "Nunito"
    }
  },
  "font-weight": {
    "regular": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_WEIGHT"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "number",
      "$value": 400
    },
    "medium": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_WEIGHT"
        ],
        "com.figma.hiddenFromPublishing": false
      },
