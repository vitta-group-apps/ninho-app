# Supabase — vai em https://supabase.com/dashboard/project/_id_/settings/api
VITE_SUPABASE_URL=https://<project-id>.supabase.co

# Usa UMA das duas variáveis abaixo (dependendo de como o projeto foi criado):
# Criado manualmente / dashboard:
VITE_SUPABASE_ANON_KEY=cole_aqui_a_anon_key
# Criado via MCP (Supabase CLI / scaffolding):
# VITE_SUPABASE_PUBLISHABLE_KEY=cole_aqui_a_publishable_key
